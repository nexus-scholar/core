{
    "name": "nexus-scholar/core",
    "description": "Systematic Literature Review toolkit for PHP 8.3+",
    "type": "library",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../graph-core",
            "options": {
                "symlink": true,
                "versions": {
                    "mbsoft31/graph-core": "1.0.0"
                }
            }
        },
        {
            "type": "path",
            "url": "../graph-algorithms",
            "options": {
                "symlink": true,
                "versions": {
                    "mbsoft31/graph-algorithms": "1.0.0"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "mbsoft31/graph-core": "^1.0",
        "mbsoft31/graph-algorithms": "^1.0",
        "guzzlehttp/guzzle": "^7.8",
        "composer/ca-bundle": "^1.5",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.1",
        "mockery/mockery": "^1.6",
        "php-vcr/php-vcr": "^1.7",
        "orchestra/testbench": "^11.1"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nexus\\Laravel\\NexusServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "php -d memory_limit=512M vendor/bin/pest",
        "test:unit": "php -d memory_limit=512M vendor/bin/pest tests/Unit",
        "test:feature": "php -d memory_limit=512M vendor/bin/pest tests/Feature",
        "analyse": "php -d memory_limit=512M vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint --dirty",
        "format:check": "vendor/bin/pint --test --dirty"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
